# Serve mock data from src/lib/api/fixtures instead of calling the external API.
# Stays true until the API contract exists and the real client is implemented.
VITE_USE_MOCK_API=true

# Basemap style. Defaults to CARTO Positron, which needs no API key.
# Replace with the client's vector tile style when it is available.
VITE_BASEMAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
