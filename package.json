{
  "name": "agora-paraguay",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "setup": "pnpm build && pnpm exec playwright install chromium",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && prek install || true",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@radix-ui/react-label": "2.1.15",
