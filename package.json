{
  "name": "agora-paraguay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "setup": "pnpm build && pnpm exec playwright install chromium",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && prek install || true"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-toggle": "1.1.18",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tmcw/togeojson": "7.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "jotai": "2.20.3",
    "lucide-react": "1.33.0",
    "maplibre-gl": "6.5.0",
    "nuqs": "2.10.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.2",
    "shpjs": "6.2.0",
    "tailwind-merge": "3.6.0",
    "terra-draw": "1.32.3",
    "terra-draw-maplibre-gl-adapter": "1.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@j178/prek": "0.5.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "1.155.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/shpjs": "3.4.7",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
