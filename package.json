    "clsx": "2.1.1",
    "maplibre-gl": "5.24.0",
    "nuqs": "2.9.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "8.1.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@j178/prek": "0.4.13",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "1.155.0",
    "@types/node": "24.13.3",
