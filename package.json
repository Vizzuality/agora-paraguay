    "maplibre-gl": "6.11.2",
    "nuqs": "2.10.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "react-markdown": "10.1.0",
    "shpjs": "6.2.0",
    "tailwind-merge": "3.7.0",
    "terra-draw": "1.35.0",
    "terra-draw-maplibre-gl-adapter": "1.4.1",
