    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tmcw/togeojson": "7.1.2",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
